# Environment variables for command-line tools

# My binary
export PATH="/Users/vxoxvx/Bin:$PATH"

# XDG
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_RUNTIME_DIR="$HOME/.local/run/user/$UID"
export PATH="/Users/vxoxvx/.local/bin:$PATH"

# Vim
SHELL_SESSIONS_DISABLE=1

# Node
NODE_REPL_HISTORY="$XDG_STATE_HOME/node_repl_history"

# NPM
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME/npm/npmrc"
export NPM_CONFIG_INIT_MODULE="$XDG_CONFIG_HOME/npm/config/npm-init.js"
export NPM_CONFIG_CACHE="$XDG_CACHE_HOME/npm"

# Cargo & Rustup
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export RUSTUP_HOME="$XDG_DATA_HOME/rustup"

# Go
export GOPATH="$XDG_DATA_HOME/go"
export PATH="$PATH:$GOPATH/bin"

# Gradle
export GRADLE_USER_HOME="$XDG_DATA_HOME/gradle"

# Ghcup
export GHCUP_USE_XDG_DIRS=true

# Python
export PYTHON_HISTORY="$XDG_STATE_HOME/python_history"

# Android
export ANDROID_USER_HOME="$XDG_DATA_HOME/android"
export ANDROID_AVD_HOME="$XDG_DATA_HOME/android/avd"

# tldr
export TLDR_CACHE_DIR="$XDG_CACHE_HOME/tldr"

# Docker
export DOCKER_CONFIG="$XDG_CONFIG_HOME"/docker
